    given-names: "Peter"
    affiliation: "Cold Spring Harbor Laboratory"
license: "MIT"
url: "https://cameo-db.github.io"
repository-code: "https://github.com/cameo-db/cameo-db.github.io"
keywords:
  - machine learning
  - model architecture
  - reproducibility
  - benchmarks
