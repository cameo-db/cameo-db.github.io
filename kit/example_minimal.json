    "patience": 3
   },
   "checkpoint": "best_validation",
   "shuffle": true,
   "definitions": {},
   "augmentation": "none",
   "init": "random",
   "code": {
    "entry_point": "train",
    "script": "def train(net, loader, valid, settings):\n    opt = torch.optim.Adam(net.parameters(), lr=settings[\"lr\"])\n    best, best_state, bad = float(\"inf\"), None, 0\n    for epoch in range(settings[\"epochs\"]):\n        net.train()\n        for x, y in loader:                      # loader shuffles\n            loss = F.mse_loss(net(x), y)         # mean over examples\n            opt.zero_grad(); loss.backward(); opt.step()\n        score = evaluate(net, valid)             # validation MSE\n        if score < best:\n            best, best_state, bad = score, {k: v.clone() for k, v in net.state_dict().items()}, 0\n        else:\n            bad += 1\n            if bad >= settings[\"patience\"]:\n                break\n    net.load_state_dict(best_state)              # score the best epoch\n    return best\n"
   }
  }
